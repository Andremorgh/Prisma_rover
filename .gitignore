.ipynb_checkpoints/

# OS-specific files
.DS_Store
Thumbs.db
desktop.ini

# Local IDE and editor configurations
.vscode/
.idea/
*.swp
*.swo
*~
*.save
.project
.pydevproject
.settings/

# Log directories and files
log/
*.log

# Large data, backups and trained model weights (except package-specific static models)
