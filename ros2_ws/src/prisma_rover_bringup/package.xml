<?xml version="1.0"?>
<package format="3">
  <name>prisma_rover_bringup</name>
  <version>0.0.0</version>
  <description>Bringup launch files and configuration for the real physical Prisma Rover hardware</description>
  <maintainer email="andrea@todo.todo">Andrea</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>rclcpp</exec_depend>
  <exec_depend>roboclaw_ros2</exec_depend>
  <exec_depend>prisma_rover_description</exec_depend>
  <exec_depend>prisma_rover_interfaces</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>rplidar_ros</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
