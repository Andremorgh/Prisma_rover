<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rover_macro">
    
    <!-- Rover properties -->
    <xacro:property name="track_width" value="0.08"/>
    <xacro:property name="total_width" value="0.4515"/>
    <xacro:property name="total_length" value="0.422"/>
    <xacro:property name="total_height" value="0.202"/>
    <xacro:property name="chassis_width" value="0.241"/>
    <xacro:property name="chassis_height" value="0.0785"/>
    <xacro:property name="chassis_length" value="0.320"/>
    <xacro:property name="track_distance" value="0.2915"/>
    <xacro:property name="wheel_axes_distance" value="0.220"/>
    <xacro:property name="wheel_collision_x" value="${total_length/2 - total_height/2 - 0.001}"/>
    <xacro:property name="wheel_collision_y" value="${track_width}"/>
    <xacro:property name="wheel_collision_z" value="${total_height - 0.02}"/>
    <xacro:property name="rover_z_elev" value="${total_height/2 - chassis_height/2}"/>
    <xacro:property name="collision_z_elev" value="${chassis_height/2}"/>
    
    <!-- Robot Parameters -->
    <xacro:property name="wheel_z_offset" value="0.020" />
    <xacro:property name="wheel_x_offset" value="${wheel_axes_distance/2}" />
    <xacro:property name="front_flipper_x_offset" value="-0.0035" />
    <xacro:property name="wheel_y_offset" value="${(total_width-track_width)/2}" />
    <xacro:property name="track_y_offset" value="0.11" />
    <xacro:property name="wheel_mass" value="1.25" />
    <xacro:property name="payload_z_offset" value="0.096" />

    <!-- Include extra URDF files -->
    <xacro:include filename="$(find prisma_rover_description)/urdf/imu.urdf" />

    <xacro:property name="tf_prefix_val" value="$(arg tf_prefix)"/>

    <xacro:macro name="rover_base_frame" params="parent_link">
        <joint name="world_base_joint" type="fixed">
            <parent link="${parent_link}"/>
            <child link="base_link"/>
            <origin xyz="0.0 0.0 ${rover_z_elev}" rpy="0.0 0.0 0.0"/>
        </joint>
        
        <link name="base_link">
            <visual>
                <origin xyz="0 0 -0.035" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="file://$(find prisma_rover_description)/meshes/prisma_rover.obj" scale="0.001 0.001 0.001"/>
                </geometry>
                <material name="silver">
                    <color rgba="0.7 0.7 0.7 1.0"/>
                </material>
            </visual>
            <inertial>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <mass value="10.0"/>
                <xacro:box_inertia m="10.0" x="${total_length}" y="${total_width}" z="${total_height}"/>
            </inertial>
            <collision>
                <origin xyz="0.0 0.0 ${collision_z_elev}" rpy="0.0 0.0 0.0"/>
                <geometry>
                    <box size="${total_length} ${total_width - 2*track_width} ${total_height - 0.0005}"/>                
                </geometry>
            </collision>
        </link>

        <link name="pole_link">
            <collision>
                <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
                <geometry>
                    <cylinder radius="0.0125" length="${1.1-2*total_height}"/>
                </geometry>
            </collision>
        </link>    
    </xacro:macro>

    <link name="payload_link">
        <collision>
            <origin xyz="0 0.0115 0.05" rpy="0 0 0" />
            <geometry>
                <box size="${total_length} ${total_width - 2*track_width} 0.03"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="-0.01 0 0" rpy="0 0 0"/>
            <mass value="2.95" />
            <inertia ixx="0.018398" ixy="0.0" ixz="0.0" iyy="0.04064" iyz="0.0" izz="0.05396" />
        </inertial>
    </link>

    <joint name="payload_to_base" type="fixed">
        <parent link="base_link"/>
        <child link="payload_link"/>
        <origin xyz="0 0 ${payload_z_offset}"/>
    </joint>

    <joint name="pole_to_payload" type="fixed">
        <origin xyz="0 0 ${0.5 - total_height/2}" rpy="0 0 0"/>
        <parent link="payload_link"/>
        <child link="pole_link"/>
    </joint>


    <!-- Lidar Gazebo Sensor -->
    <xacro:macro name="lidar_gazebo_sensor" params="laser_frame laser_topic namespace">
        <joint name="lidar_to_payload" type="fixed">
            <parent link="payload_link"/>
            <child link="${laser_frame}"/>
            <origin xyz="0.0 0.0 0.16" rpy="0.0 0.0 0.0"/>
        </joint>

        <link name="${laser_frame}">
            <visual>
                <origin xyz="0 0 0" rpy="-1.57 3.1415 3.1415"/>
                <geometry>
                    <mesh filename="file://$(find prisma_rover_description)/meshes/rplidar_s2.obj"/>
                </geometry>
                <material name="lidar_red">
                    <color rgba="0.8 0.2 0.2 1.0"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 -0.05" rpy="0 0 3.1415"/>
                <geometry>
                    <cylinder radius="0.05" length="0.15"/>
                </geometry>
            </collision>
        </link>

        <gazebo reference="${laser_frame}">
            <visual>
                <material>
                    <ambient>0.5 0.1 0.1 1.0</ambient>
                    <diffuse>0.7 0.2 0.2 1.0</diffuse>
                    <specular>0.6 0.6 0.6 1.0</specular>
                </material>
                <visibility_flags>2</visibility_flags>
            </visual>
            <sensor name='gpu_lidar' type='gpu_lidar'>
                <pose>0 0 0.03 0 0 0</pose>
                <topic>${namespace}/${laser_topic}</topic>
                <ignition_frame_id>${tf_prefix_val}lidar_link</ignition_frame_id>
                <update_rate>10</update_rate>
                <lidar>
                    <visibility_mask>4</visibility_mask>
                    <scan>
                        <horizontal>
                            <samples>640</samples>
                            <resolution>1</resolution>
                            <min_angle>-3.14159</min_angle>
                            <max_angle>3.14159</max_angle>
                        </horizontal>
                        <vertical>
                            <samples>1</samples>
                            <resolution>1</resolution>
                            <min_angle>0.0</min_angle>
                            <max_angle>0.0</max_angle>
                        </vertical>
                    </scan>
                    <range>
                        <min>0.15</min>
                        <max>10.0</max>
                        <resolution>0.01</resolution>
                    </range>
                </lidar>
                <visualize>true</visualize>
            </sensor>
        </gazebo>
    </xacro:macro>

    <!-- Livox Mid-360 Lidar Gazebo Sensor -->
    <!-- The physical Livox Mid-360 has a cylinder-like form factor (65mm diameter x 40mm height) -->
    <xacro:macro name="livox_mid360_gazebo_sensor" params="laser_frame laser_topic namespace">
        <joint name="livox_to_payload" type="fixed">
            <parent link="payload_link"/>
            <child link="${laser_frame}"/>
            <origin xyz="0.0 0.0 0.16" rpy="0.0 0.0 0.0"/>
        </joint>

        <link name="${laser_frame}">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <cylinder radius="0.0325" length="0.04"/> <!-- 65mm diameter, 40mm height -->
                </geometry>
                <material name="dark_grey">
                    <color rgba="0.2 0.2 0.2 1.0"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <cylinder radius="0.0325" length="0.04"/>
                </geometry>
            </collision>
        </link>

        <gazebo reference="${laser_frame}">
            <visual>
                <material>
                    <ambient>0.5 0.1 0.1 1.0</ambient>
                    <diffuse>0.7 0.2 0.2 1.0</diffuse>
                    <specular>0.6 0.6 0.6 1.0</specular>
                </material>
                <visibility_flags>2</visibility_flags>
            </visual>
            <sensor name='livox_mid360' type='gpu_lidar'>
                <pose>0 0 0.03 0 0 0</pose>
                <topic>${namespace}/${laser_topic}</topic>
                <ignition_frame_id>${tf_prefix_val}livox_link</ignition_frame_id>
                <update_rate>10</update_rate> <!-- 10 Hz typical Livox scanning/spin rate -->
                <lidar>
                    <visibility_mask>4</visibility_mask>
                    <scan>
                        <horizontal>
                            <samples>360</samples>
                            <resolution>1</resolution>
                            <!-- 360° Horizontal FOV -->
                            <min_angle>-3.14159</min_angle>
                            <max_angle>3.14159</max_angle>
                        </horizontal>
                        <vertical>
                            <samples>60</samples>
                            <resolution>1</resolution>
                            <!-- 59° Vertical FOV: -7° (-0.122 rad) to +52° (0.907 rad) -->
                            <min_angle>-0.122</min_angle>
                            <max_angle>0.907</max_angle>
                        </vertical>
                    </scan>
                    <range>
                        <!-- Minimum range of 0.1m matches the physical Livox specs -->
                        <min>0.1</min>
                        <!-- Maximum range capped at 20m in simulation for performance/indoor bounds -->
                        <!-- (Physical Livox Mid-360 can range up to 40m at 10% reflectivity) -->
                        <max>20.0</max>
                        <resolution>0.01</resolution>
                    </range>
                </lidar>
                <visualize>true</visualize>
            </sensor>
        </gazebo>
    </xacro:macro>

</robot>
