<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rover_macro">
    
    <!-- Rover properties -->
    <xacro:property name="track_width" value="0.08"/>
    <xacro:property name="total_width" value="0.4515"/>
    <xacro:property name="total_length" value="0.422"/>
    <xacro:property name="total_height" value="0.202"/>
    <xacro:property name="chassis_width" value="0.241"/>
    <xacro:property name="chassis_height" value="0.0785"/>
    <xacro:property name="chassis_length" value="0.320"/>
    <xacro:property name="track_distance" value="0.2915"/>
    <xacro:property name="wheel_axes_distance" value="0.220"/>
    <xacro:property name="wheel_collision_x" value="${total_length/2 - total_height/2 - 0.001}"/>
    <xacro:property name="wheel_collision_y" value="${track_width}"/>
    <xacro:property name="wheel_collision_z" value="${total_height - 0.02}"/>
    <xacro:property name="rover_z_elev" value="${total_height/2 - chassis_height/2}"/>
    <xacro:property name="collision_z_elev" value="${chassis_height/2}"/>
    
    <!-- Robot Parameters -->
    <xacro:property name="wheel_z_offset" value="0.020" />
    <xacro:property name="wheel_x_offset" value="${wheel_axes_distance/2}" />
    <xacro:property name="front_flipper_x_offset" value="-0.0035" />
    <xacro:property name="wheel_y_offset" value="${(total_width-track_width)/2}" />
    <xacro:property name="track_y_offset" value="0.11" />
    <xacro:property name="wheel_mass" value="1.25" />
    <xacro:property name="payload_z_offset" value="0.096" />

    <xacro:macro name="rover_base_frame" params="parent_link">
        <joint name="world_base_joint" type="fixed">
            <parent link="${parent_link}"/>
            <child link="base_link"/>
            <origin xyz="0.0 0.0 ${rover_z_elev}" rpy="0.0 0.0 0.0"/>
        </joint>
        
        <link name="base_link">
            <visual>
                <origin xyz="0 0 -0.035" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://prisma_rover_description/meshes/prisma_rover.dae" scale="0.001 0.001 0.001"/>
                </geometry>
                <material name="silver">
                    <color rgba="0.7 0.7 0.7 1.0"/>
                </material>
            </visual>
            <inertial>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <mass value="10.0"/>
                <xacro:box_inertia m="10.0" x="${total_length}" y="${total_width}" z="${total_height}"/>
            </inertial>
            <collision>
                <origin xyz="0.0 0.0 ${collision_z_elev}" rpy="0.0 0.0 0.0"/>
                <geometry>
                    <box size="${total_length} ${total_width - 2*track_width} ${total_height - 0.0005}"/>                
                </geometry>
            </collision>
        </link>

        <link name="payload_link">
            <collision>
                <origin xyz="0 0.0115 0.05" rpy="0 0 0" />
                <geometry>
                    <box size="${total_length} ${total_width - 2*track_width} 0.03"/>
                </geometry>
            </collision>
            <inertial>
                <origin xyz="-0.01 0 0" rpy="0 0 0"/>
                <mass value="2.95" />
                <inertia ixx="0.018398" ixy="0.0" ixz="0.0" iyy="0.04064" iyz="0.0" izz="0.05396" />
            </inertial>
        </link>

        <joint name="payload_to_base" type="fixed">
            <parent link="base_link"/>
            <child link="payload_link"/>
            <origin xyz="0 0 ${payload_z_offset}"/>
        </joint>

        <link name="pole_link">
            <collision>
                <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
                <geometry>
                    <cylinder radius="0.0125" length="${1.1-2*total_height}"/>
                </geometry>
            </collision>
        </link>    

        <joint name="pole_to_payload" type="fixed">
            <origin xyz="0 0 ${0.5 - total_height/2}" rpy="0 0 0"/>
            <parent link="payload_link"/>
            <child link="pole_link"/>
        </joint>
    </xacro:macro>

    <!-- Wheels Description (needed for physical visualization via real /joint_states) -->
    <xacro:macro name="rover_wheels">
        <!-- Front Right Wheel -->
        <link name="fr_wheel_link">
            <visual>
                <origin xyz="0 0 0" rpy="-1.57 0 0" />
                <geometry>
                    <mesh filename="package://prisma_rover_description/meshes/pro_tire.dae" scale="0.5 0.5 1.0"/>
                </geometry>
                <material name="dark_grey">
                    <color rgba="0.15 0.15 0.15 1.0"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="-1.57 0 0" />
                <geometry>
                    <cylinder radius="${total_height/2}" length="${track_width}"/>
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <mass value="${wheel_mass}" />
                <inertia ixx="0.005645" ixy="0.0" ixz="0.0" iyy="0.01008" iyz="0.0" izz="0.005645"/>
            </inertial>
        </link>
        
        <joint name="fr_wheel_to_base" type="continuous">
            <parent link="base_link"/> 
            <child link="fr_wheel_link"/>
            <axis xyz="0 1 0"/>
            <origin xyz="${wheel_x_offset + front_flipper_x_offset} ${-wheel_y_offset} 0" rpy="0 0 0"/>
        </joint>

        <!-- Front Left Wheel -->
        <link name="fl_wheel_link">
            <visual>
                <origin xyz="0 0 0" rpy="1.57 0 0" />
                <geometry>
                    <mesh filename="package://prisma_rover_description/meshes/pro_tire.dae" scale="0.5 0.5 1.0"/>
                </geometry>
                <material name="dark_grey">
                    <color rgba="0.15 0.15 0.15 1.0"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="1.57 0 0" />
                <geometry>
                    <cylinder radius="${total_height/2}" length="${track_width}"/>
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <mass value="${wheel_mass}" />
                <inertia ixx="0.005645" ixy="0.0" ixz="0.0" iyy="0.01008" iyz="0.0" izz="0.005645"/>
            </inertial>
        </link>

        <joint name="fl_wheel_to_base" type="continuous">
            <parent link="base_link"/>
            <child link="fl_wheel_link"/>
            <axis xyz="0 1 0"/>
            <origin xyz="${wheel_x_offset + front_flipper_x_offset} ${wheel_y_offset} 0" rpy="0 0 0"/>
        </joint>

        <!-- Rear Right Wheel -->
        <link name="rr_wheel_link">
            <visual>
                <origin xyz="0 0 0" rpy="1.57 0 3.1415" />
                <geometry>
                    <mesh filename="package://prisma_rover_description/meshes/pro_tire.dae" scale="0.5 0.5 1.0"/>
                </geometry>
                <material name="dark_grey">
                    <color rgba="0.15 0.15 0.15 1.0"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="1.57 0 3.1415" />
                <geometry>
                    <cylinder radius="${total_height/2}" length="${track_width}"/>
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <mass value="${wheel_mass}" />
                <inertia ixx="0.005645" ixy="0.0" ixz="0.0" iyy="0.01008" iyz="0.0" izz="0.005645"/>
            </inertial>
        </link>

        <joint name="rr_wheel_to_base" type="continuous">
            <parent link="base_link"/>
            <child link="rr_wheel_link"/>
            <axis xyz="0 1 0"/>
            <origin xyz="${-wheel_x_offset} ${-wheel_y_offset} 0" rpy="0 0 0"/>
        </joint>

        <!-- Rear Left Wheel -->
        <link name="rl_wheel_link">
            <visual>
                <origin xyz="0 0 0" rpy="-1.57 0 3.1415" />
                <geometry>
                    <mesh filename="package://prisma_rover_description/meshes/pro_tire.dae" scale="0.5 0.5 1.0"/>
                </geometry>
                <material name="dark_grey">
                    <color rgba="0.15 0.15 0.15 1.0"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="-1.57 0 3.1415" />
                <geometry>
                    <cylinder radius="${total_height/2}" length="${track_width}"/>
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <mass value="${wheel_mass}" />
                <inertia ixx="0.005645" ixy="0.0" ixz="0.0" iyy="0.01008" iyz="0.0" izz="0.005645"/>
            </inertial>
        </link>

        <joint name="rl_wheel_to_base" type="continuous">
            <parent link="base_link"/>
            <child link="rl_wheel_link"/>
            <axis xyz="0 1 0"/>
            <origin xyz="${-wheel_x_offset} ${wheel_y_offset} 0" rpy="0 0 0"/>
        </joint>
    </xacro:macro>

    <!-- IMU Description -->
    <xacro:macro name="imu_description">
        <link name="imu_link"/>
        <joint name="imu_to_payload" type="fixed">
            <parent link="base_link"/>
            <child link="imu_link"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </joint>
    </xacro:macro>

    <!-- RealSense RGB-D Camera Description -->
    <xacro:macro name="camera_description">
        <joint name="camera_to_payload" type="fixed">
            <origin xyz="0.22 0.0 0.15" rpy="0 0 0"/>
            <parent link="payload_link"/>
            <child link="camera_link"/>
        </joint>

        <link name="camera_link">
            <visual>
                <origin xyz="0 0 0" rpy="1.57 0 1.57"/>
                <geometry>
                    <mesh filename="package://prisma_rover_description/meshes/realsense.dae"/>
                </geometry>
                <material name="camera_black">
                    <color rgba="0.2 0.2 0.2 1.0"/>
                </material>
            </visual>
            <collision>
                <origin xyz="-0.01 0.0 0.0" rpy="0 0 0"/>
                <geometry>
                    <box size="0.02 0.1 0.025"/>
                </geometry>
            </collision>        
        </link>

        <joint name="camera_rgb_joint" type="fixed">
            <origin xyz="0.005 0.018 0.013" rpy="0 0 0"/>
            <parent link="camera_link"/>
            <child link="camera_rgb_frame"/>
        </joint>
        <link name="camera_rgb_frame"/>

        <joint name="camera_rgb_optical_joint" type="fixed">
            <origin xyz="0 0 0" rpy="-1.57 0 -1.57"/>
            <parent link="camera_rgb_frame"/>
            <child link="camera_rgb_optical_frame"/>
        </joint>
        <link name="camera_rgb_optical_frame"/>

        <joint name="camera_depth_joint" type="fixed">
            <origin xyz="0.005 0.028 0.013" rpy="0 0 0"/>
            <parent link="camera_link"/>
            <child link="camera_depth_frame"/>
        </joint>
        <link name="camera_depth_frame"/>

        <joint name="camera_depth_optical_joint" type="fixed">
            <origin xyz="0 0 0" rpy="-1.57 0 -1.57"/> 
            <parent link="camera_depth_frame"/>
            <child link="camera_depth_optical_frame"/>
        </joint>
        <link name="camera_depth_optical_frame"/>
    </xacro:macro>

    <!-- 2D RPLidar Lidar Description -->
    <xacro:macro name="lidar_description" params="laser_frame">
        <joint name="lidar_to_payload" type="fixed">
            <parent link="payload_link"/>
            <child link="${laser_frame}"/>
            <origin xyz="0.0 0.0 0.16" rpy="0.0 0.0 0.0"/>
        </joint>

        <link name="${laser_frame}">
            <visual>
                <origin xyz="0 0 0" rpy="-1.57 3.1415 3.1415"/>
                <geometry>
                    <mesh filename="package://prisma_rover_description/meshes/rplidar_s2.dae"/>
                </geometry>
                <material name="lidar_red">
                    <color rgba="0.8 0.2 0.2 1.0"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 -0.05" rpy="0 0 3.1415"/>
                <geometry>
                    <cylinder radius="0.05" length="0.15"/>
                </geometry>
            </collision>
        </link>
    </xacro:macro>

    <!-- 3D Livox Mid-360 Lidar Description -->
    <xacro:macro name="livox_mid360_description" params="laser_frame">
        <joint name="livox_to_payload" type="fixed">
            <parent link="payload_link"/>
            <child link="${laser_frame}"/>
            <origin xyz="0.0 0.0 0.16" rpy="0.0 0.0 0.0"/>
        </joint>

        <link name="${laser_frame}">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <cylinder radius="0.0325" length="0.04"/>
                </geometry>
                <material name="dark_grey">
                    <color rgba="0.2 0.2 0.2 1.0"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <cylinder radius="0.0325" length="0.04"/>
                </geometry>
            </collision>
        </link>
    </xacro:macro>

</robot>
