<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rover">

    <xacro:include filename="$(find prisma_rover_description)/urdf/rover_macro.xacro"/>
    <xacro:include filename="$(find prisma_rover_description)/urdf/utilities.xacro"/>
    <xacro:include filename="$(find prisma_rover_description)/urdf/rover_gazebo.xacro"/>

    <!-- Launch Arguments -->
    <xacro:arg name="is_sim" default="true"/>
    <xacro:arg name="namespace" default=""/>
    <xacro:arg name="frame_prefix" default=""/>
    <xacro:arg name="tf_prefix" default=""/>
    <xacro:arg name="publish_camera" default="true"/>
    <xacro:arg name="lidar_type" default="2d"/>

    <!-- Base footprint at ground level -->
    <link name="base_footprint"/>

    <!-- Setup structural links and base joint -->
    <xacro:rover_base_frame parent_link="base_footprint"/>

    <!-- IMU Link and Sensor -->
    <xacro:imu_macro namespace="$(arg namespace)"/>

    <!-- Simulation-only elements -->
    <xacro:if value="$(arg is_sim)">
        <xacro:rover_wheels_sim left_joint="diff_drive_l_joint" right_joint="diff_drive_r_joint"/>
        <xacro:gazebo_diff_drive_controller left_joint="diff_drive_l_joint" right_joint="diff_drive_r_joint" namespace="$(arg namespace)"/>
        <xacro:gazebo_wheel_contact/>
        
        <!-- Conditionally load Lidar type -->
        <xacro:if value="${'$(arg lidar_type)' == '2d'}">
            <xacro:lidar_gazebo_sensor laser_frame="lidar_link" laser_topic="scan" namespace="$(arg namespace)"/>
        </xacro:if>
        <xacro:if value="${'$(arg lidar_type)' == '3d'}">
            <xacro:livox_mid360_gazebo_sensor laser_frame="livox_link" laser_topic="scan_3d" namespace="$(arg namespace)"/>
        </xacro:if>
        
        <!-- Conditionally instantiate the camera in simulation -->
        <xacro:if value="$(arg publish_camera)">
            <xacro:camera_gazebo camera_base_frame="camera_link" camera_topic="camera" camera_info_topic="camera_info" namespace="$(arg namespace)"/>
        </xacro:if>
    </xacro:if>

    <!-- Real-hardware elements (simulation plugins are bypassed) -->
    <xacro:unless value="$(arg is_sim)">
        <xacro:if value="${'$(arg lidar_type)' == '2d'}">
            <xacro:lidar_gazebo_sensor laser_frame="lidar_link" laser_topic="scan" namespace="$(arg namespace)"/>
        </xacro:if>
        <xacro:if value="${'$(arg lidar_type)' == '3d'}">
            <xacro:livox_mid360_gazebo_sensor laser_frame="livox_link" laser_topic="scan_3d" namespace="$(arg namespace)"/>
        </xacro:if>
    </xacro:unless>

</robot>
